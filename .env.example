# Dota 2 Steam 32-bit Account ID (từ link https://www.dotabuff.com/players/196931374)
DOTA_ACCOUNT_ID=196931374

# Kênh livestream cần lắng nghe chat (vd: @DHDota2 hoặc link https://www.youtube.com/@DHDota2)
TARGET_CHANNEL=@DHDota2

# (KHUYẾN NGHỊ CAO) Steam Web API Key để cập nhật trận đấu theo THỜI GIAN THỰC (0 giây ngay khi vừa đánh xong!)
# Lấy miễn phí tại: https://steamcommunity.com/dev/apikey (chỉ cần nhập domain bất kỳ vd: localhost)
STEAM_API_KEY=

# Khoảng cách tối đa giữa các trận đấu để tính chung vào 1 ca stream (mặc định: 5 tiếng)
# Nếu 2 trận cách nhau quá 5 tiếng (ngủ/nghỉ ca), các trận cũ sẽ không bị tính vào ca stream hôm nay
SESSION_GAP_HOURS=5.0

# (Tùy chọn) ID của buổi livestream nếu muốn chỉ định trực tiếp (vd: IuM8Nhptdy4)
YOUTUBE_VIDEO_ID=

# Múi giờ để tính số trận hôm nay (7 = GMT+7 Việt Nam)
TIMEZONE_OFFSET=7

# (Tùy chọn) MMR thực tế của streamer nếu muốn hiển thị con số cụ thể cho người xem (vd: 10500)
MANUAL_MMR=

# (Tùy chọn) OpenDota API Key nếu có tài khoản trả phí
OPENDOTA_API_KEY=

# Đường dẫn file credentials OAuth 2.0 tải từ Google Cloud Console
CLIENT_SECRET_FILE=client_secret.json

# Thời gian chờ giữa các lần thực thi lệnh chat (giây) để chống spam
COMMAND_COOLDOWN=8.0
